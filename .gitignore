# --- Maven build output ---
# Regenerated on every build. Never commit this.
target/

# Written by the shade plugin every package. A generated copy of pom.xml
# with the bundled dependencies stripped out - not the build's input.
dependency-reduced-pom.xml

# --- jpackage output ---
# The built game and its staging folder. Regenerated by Build EXE.bat,
# and a couple of hundred MB of bundled Java runtime besides.
dist/
build/

# --- NetBeans ---
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# --- Other IDEs ---
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log

# --- Claude's scratch ---
# Screenshots, patches, held copies and notes a Cowork session leaves on the
# PC for Jerus to look at. The code is in src/, the record in the claude.ai
# project; nothing here is either.
Claude outputs/

# --- Python ---
# Running tools/earth/*.py (E0's bake, earthread.py, fixture.py) writes a
# bytecode cache beside the scripts.
__pycache__/

# --- The Earth's data ---
# earth-1.bin (about 53 MB), the real Earth a city can be founded on since
# 0.7.121 (EarthData.DATA_FILE, data/earth-1.bin beside the game, or named
# with -Dcbs.earth=<path>). Not in the repository: it ships beside the game,
# and the game runs without it - the founding screen offers the generated
# world then, and says where the file goes. tools/earth/ bakes it.
data/
