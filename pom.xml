<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>Ham</groupId>
    <artifactId>CityBuilderSim</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21</javafx.version>
    </properties>

    <dependencies>

        <!-- Gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

    </dependencies>

    <build>
        <!-- The jar's resources: the default folder, and (CR1) the two data files'
             credits from the pipelines that write them, for the Credits page. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>tools</directory>
                <targetPath>credits</targetPath>
                <includes>
                    <include>earth/ATTRIBUTION-2.txt</include>
                    <include>world/ATTRIBUTION.txt</include>
                </includes>
            </resource>
            <!-- CR1-L: these releases' jars omit legal files; one checked copy
                 from each upstream release, with provenance in sources.properties. -->
            <resource>
                <directory>tools/credits</directory>
                <targetPath>credits</targetPath>
            </resource>
        </resources>
        <plugins>

            <!-- CR1-L review: resource copying alone silently skips missing files. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>require-credits-notices</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <message>The Credits page requires every library licence, notice and its provenance.</message>
                                    <files>
                                        <file>${project.basedir}/tools/credits/gson/LICENSE</file>
                                        <file>${project.basedir}/tools/credits/openjfx/LICENSE</file>
                                        <file>${project.basedir}/tools/credits/openjfx/ADDITIONAL_LICENSE_INFO</file>
                                        <file>${project.basedir}/tools/credits/openjfx/ASSEMBLY_EXCEPTION</file>
                                        <file>${project.basedir}/tools/credits/openjfx/jpeg_fx.md</file>
                                        <file>${project.basedir}/tools/credits/openjfx/mesa3d.md</file>
                                        <file>${project.basedir}/tools/credits/sources.properties</file>
                                    </files>
                                </requireFilesExist>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JavaFX run support (IMPORTANT for your project) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>ham.citybuildersim.CityBuilderSim</mainClass>
                </configuration>
            </plugin>

            <!-- Fixes "no main manifest attribute" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>ham.citybuildersim.CityBuilderSim</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Builds a standalone executable jar (with all dependencies bundled) as a separate artifact -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>executable</shadedClassifierName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ham.citybuildersim.CityBuilderSim</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
