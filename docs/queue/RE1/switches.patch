diff --git a/src/main/java/ham/citybuildersim/RE1.java b/src/main/java/ham/citybuildersim/RE1.java
new file mode 100644
index 00000000..ddc66130
--- /dev/null
+++ b/src/main/java/ham/citybuildersim/RE1.java
@@ -0,0 +1,35 @@
+package ham.citybuildersim;
+
+import java.util.Set;
+
+/**
+ * RE1's study switches (never shipped): each is OFF unless named in -Dre1.off=a,b and the month has reached -Dre1.from.
+ * The driver sets {@link #month} to the months already run before it plays the next one, so a run forks from an identical path.
+ * With re1.off unset every switch is inert and the run is byte-identical to an unswitched one.
+ *
+ * Keys: floor, latent, gate, wages, posts, down (the landlords), subsidy (the driver's).
+ */
+public final class RE1 {
+
+    private RE1() { }
+
+    /** The months already run, set by the study driver every month. */
+    public static volatile int month;
+
+    private static final Set<String> KEYS = parse(System.getProperty("re1.off", ""));
+    private static final int FROM = Integer.getInteger("re1.from", 0);
+
+    private static Set<String> parse(String list) {
+        Set<String> out = new java.util.HashSet<>();
+        for (String k : list.split(",")) {
+            String t = k.trim();
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+
+    /** Whether this switch is armed: named in re1.off, and the month has reached re1.from. */
+    public static boolean off(String key) {
+        return !KEYS.isEmpty() && month >= FROM && KEYS.contains(key);
+    }
+}
