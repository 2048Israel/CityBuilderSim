diff --git a/src/main/java/ham/citybuildersim/ST1.java b/src/main/java/ham/citybuildersim/ST1.java
new file mode 100644
index 00000000..76bf6b75
--- /dev/null
+++ b/src/main/java/ham/citybuildersim/ST1.java
@@ -0,0 +1,41 @@
+package ham.citybuildersim;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * ST1's study switches (never shipped): each is OFF unless named in -Dst1.off=a,b and the month has reached -Dst1.from.
+ * The probe (docs/queue/ST1/ST1Probe.java) sets {@link #month} to the city's completed months before every action it takes, so a
+ * run forks from an identical path. With st1.off unset every switch is inert and the run is byte-identical to an unswitched one.
+ *
+ * Keys: keep (the coupon on the businesses' dollars abroad paid into the till and the dollars not grown, HD1's way), taxed (the
+ * coupon out of the pre-tax income, the dollars still grow by it: main's way before HD2), coupon (no coupon at all), police (the
+ * advisor never proposes a police station or headquarters), upkeep (the treasury pays no running costs for care, schools, safety
+ * and transit), upkeepsafety (...for safety alone), gate (Sector.MIN_STAFFABLE_TO_ORDER read as 0 in Staffing.passes()), gateall
+ * (Staffing.passes() always true), idle (XS1's idlefree: the builders' laid-off crews are spare while they have no site work),
+ * withheld (the builders' laid-off crews are always spare, XS1's withheld).
+ */
+public final class ST1 {
+
+    private ST1() { }
+
+    /** The city's completed months, set by the probe before each action. */
+    public static volatile int month;
+
+    private static final Set<String> KEYS = parse(System.getProperty("st1.off", ""));
+    private static final int FROM = Integer.getInteger("st1.from", 0);
+
+    private static Set<String> parse(String list) {
+        Set<String> out = new HashSet<>();
+        for (String k : list.split(",")) {
+            String t = k.trim();
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+
+    /** Whether this switch is armed: named in st1.off, and the month has reached st1.from. */
+    public static boolean off(String key) {
+        return !KEYS.isEmpty() && month >= FROM && KEYS.contains(key);
+    }
+}
