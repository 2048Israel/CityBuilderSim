diff --git a/src/main/java/ham/citybuildersim/XS1.java b/src/main/java/ham/citybuildersim/XS1.java
new file mode 100644
index 00000000..fee4eb49
--- /dev/null
+++ b/src/main/java/ham/citybuildersim/XS1.java
@@ -0,0 +1,45 @@
+package ham.citybuildersim;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * XS1's study switches (never shipped): each is OFF unless named in -Dxs1.off=a,b and the month has reached -Dxs1.from.
+ * Game sets {@link #month} at the top of each month (strikeTheWorldMarket()), so a run forks from an identical path.
+ * With xs1.off unset every switch is inert and the run is byte-identical to an unswitched one.
+ *
+ * Keys: unwind (the risk-off's unwind of the hot money and the carry), vault (the vault's interest), usrate (the constant 2%
+ * for the US's rate), riskoff (no risk-off reaches the city: the unwind and the D$'s own risk-off term), quiet (the world
+ * quieted for the D$ wholesale, Game.quietTheWorldForTheD()), noise (EconomyManager.BUDGET_NOISE at 0).
+ */
+public final class XS1 {
+
+    private XS1() { }
+
+    /** The game's month, set by Game at the top of each month. */
+    public static volatile int month;
+
+    private static final Set<String> KEYS = parse(System.getProperty("xs1.off", ""));
+    private static final int FROM = Integer.getInteger("xs1.from", 0);
+
+    private static Set<String> parse(String list) {
+        Set<String> out = new HashSet<>();
+        for (String k : list.split(",")) {
+            String t = k.trim();
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+
+    /** Whether this switch is armed: named in xs1.off, and the month has reached xs1.from. */
+    public static boolean off(String key) {
+        return !KEYS.isEmpty() && month >= FROM && KEYS.contains(key);
+    }
+
+    private static final Set<String> FIRED = new HashSet<>();
+
+    /** True the first time off(key) is (the control "nudge": a one-off change of no money, to see how far the path is chaos). */
+    public static boolean once(String key) {
+        return off(key) && FIRED.add(key);
+    }
+}
