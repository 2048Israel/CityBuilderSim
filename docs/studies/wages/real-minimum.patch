     private double minimumWage = DEFAULT_MINIMUM_WAGE;
 
+    /*
+     * STUDY PROTOTYPE (docs/studies/spec-wages.md), not game code. With
+     * -Dwages.real=true the floor is a real minimum: the ladder is anchored on
+     * the going rate - the founding unskilled rung in founding money, lifted
+     * by the cost of living as every base already is - and the floor only
+     * lifts the wages under it. -Dwages.ripple=S: the band just above the
+     * highest band the floor holds up keeps at least S of its usual step over
+     * the floor.
+     */
+    static final boolean REAL = Boolean.getBoolean("wages.real");
+    static final double RIPPLE = Double.parseDouble(System.getProperty("wages.ripple", "0"));
+    private final double goingRate = DEFAULT_MINIMUM_WAGE;
+
+    /** The lowest base among a band's ungated jobs, as a multiple of the unskilled rung. */
+    private static double lowRatio(WageBand band) {
+        double low = Double.MAX_VALUE;
+        for (JobType j : JobType.values()) {
+            if (WageBand.of(j) == band && !isGated(j)) low = Math.min(low, ratioOf(j));
+        }
+        return low == Double.MAX_VALUE ? 1 : low;
+    }
