+    /** District d's change since it was last logged, appended to its log: those gone first (the newest of their type), then those come, one of each type in turn from a hashed start, so a month's batch mixes. */
+    void logDistrict(District d) {
+        if (d.logged == null) d.logged = new int[d.counts.length];
+        int T = d.counts.length;
+        int[] delta = new int[T];
+        boolean any = false;
+        for (int t = 0; t < T; t++) { delta[t] = d.counts[t] - d.logged[t]; if (delta[t] != 0) any = true; }
+        if (!any) return;
+        for (int t = 0; t < T; t++) for (int k = 0; k < -delta[t]; k++) push(d, ~t);
+        long h = (seed * 0x9E3779B97F4A7C15L) ^ (d.key * 0xC2B2AE3D27D4EB4FL) ^ (cl1Month * 0x165667B19E3779F9L);
+        int start = (int) Math.floorMod(h ^ (h >>> 29), (long) T);
+        boolean left = true;
+        while (left) {
+            left = false;
+            for (int j = 0; j < T; j++) {
+                int t = (start + j) % T;
+                if (delta[t] > 0) { push(d, t); delta[t]--; if (delta[t] > 0) left = true; }
+            }
+        }
+        System.arraycopy(d.counts, 0, d.logged, 0, T);
+    }
